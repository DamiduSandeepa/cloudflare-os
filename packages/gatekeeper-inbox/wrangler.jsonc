// Generated from cloudflare.config.ts by scripts/generate-worker-configs.ts -- do not edit.
// Change cloudflare.config.ts and run `pnpm configs:generate`.
{
  "name": "gatekeeper-inbox",
  "main": ".wrangler/validate/src/inbox.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "services": [
    {
      "binding": "WORKSHOP_EXTERNAL_MESSAGES",
      "service": "workshop-backend",
      "entrypoint": "ExternalMessageGateway",
      "props": {
        "source": "inbox"
      }
    }
  ],
  "vars": {
    "FORWARD_SECRET_HEADER": "x-inbox-secret"
  },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  }
}
